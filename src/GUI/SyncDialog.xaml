<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AMS2CM.GUI.SyncDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Updating your mods"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonText="Abort"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonText="Close"
    SecondaryButtonStyle="{StaticResource AccentButtonStyle}"
    IsSecondaryButtonEnabled="False"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <StackPanel Width="400" Spacing="20">
    <TextBlock x:Name="StatusText" Text="Please wait while your mod library is synchronized." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ProgressBar x:Name="Progress" IsIndeterminate="True" AutomationProperties.Name="Mod operation progress"/>
    <Expander x:Name="LogExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Activity details">
      <ScrollViewer Height="260" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="Logs" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
      </ScrollViewer>
    </Expander>
  </StackPanel>
</ContentDialog>
