<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AMS2CM.GUI.ErrorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Unable to continue"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonText="Copy Details"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CloseButtonText="Exit"
    DefaultButton="Close">

  <StackPanel Spacing="16" MaxWidth="440">
    <TextBlock Text="Copy the details below if you need help resolving this issue." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="Message"
      TextWrapping="Wrap"
      IsTextSelectionEnabled="True"/>
      </ScrollViewer>
    </Border>
  </StackPanel>
</ContentDialog>
