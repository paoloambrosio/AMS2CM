<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <UnoSingleProject>true</UnoSingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>OpenSimTools</Company>
    <Authors>OpenSimTools Contributors</Authors>
    <AssemblyName>AMS2CM.GUI</AssemblyName>
    <RootNamespace>AMS2CM.GUI</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <ApplicationIcon>..\Shared\AMS2CM.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Shared\Config.yaml">
      <Link>Config.yaml</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Shared\AMS2CM.ico">
      <Link>AMS2CM.ico</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
