<Window
    x:Class="AMS2CM.GUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AMS2CM.GUI"
    Title="Automobilista 2 Content Manager">
  <Grid Loaded="Root_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Padding="28,24" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
          <TextBlock Text="A2" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="AUTOMOBILISTA 2" FontSize="11" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock Text="Content Manager" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="28,24,28,20" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="NewVersionBlock" Visibility="Collapsed" Loaded="NewVersionBlock_Loaded" TextWrapping="Wrap" FontSize="13">
        <Run Text="A new version is available. "/>
        <Hyperlink NavigateUri="https://www.racedepartment.com/downloads/automobilista-2-content-manager.59727/">Download the update</Hyperlink>
      </TextBlock>
      <Grid Grid.Row="1" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="Your mod library" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="LibrarySummary" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Click="ModListMenuAdd_Click" VerticalAlignment="Center" Padding="16,10" AutomationProperties.AutomationId="AddModsButton">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Add"/>
            <TextBlock Text="Add mods"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Padding="16,14" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="72"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="MOD PACKAGE" FontSize="11" CharacterSpacing="100" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="Installed" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Grid.Column="2" Text="Enabled" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
          </Border>
          <ListView Grid.Row="1" x:Name="ModListView" SelectionMode="Extended" AllowDrop="True"
              RightTapped="ModListView_RightTapped" DragOver="ModListView_DragOver" Drop="ModListView_Drop"
              CanDragItems="True" DragItemsStarting="ModListView_DragItemsStarting" DragItemsCompleted="ModListView_DragItemsCompleted"
              AutomationProperties.Name="Mod library" Padding="4">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="CornerRadius" Value="6"/>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextFlyout>
              <MenuFlyout x:Name="ModListMenu">
                <MenuFlyoutItem Text="Enable" Click="ModListMenuEnable_Click"/>
                <MenuFlyoutItem Text="Disable" Click="ModListMenuDisable_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Add mods" Click="ModListMenuAdd_Click"/>
                <MenuFlyoutItem Text="Delete" Click="ModListMenuDelete_Click">
                  <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete"/>
                  </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
              </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:ModVM">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="72"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind PackageName}"/>
                    <TextBlock Text="{x:Bind PackageName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsOutOfDate}">
                      <SymbolIcon Symbol="Refresh" Width="12" Height="12"/>
                      <TextBlock Text="Update pending" FontSize="12"/>
                    </StackPanel>
                  </StackPanel>
                  <CheckBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Center" IsThreeState="True" IsChecked="{x:Bind IsInstalled}" IsEnabled="False" AutomationProperties.Name="Installed status"/>
                  <CheckBox Grid.Column="2" MinWidth="0" HorizontalAlignment="Center" IsThreeState="False" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind IsAvailable}" AutomationProperties.Name="Enable mod" ToolTipService.ToolTip="Include this mod when applying changes"/>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel Grid.Row="1" x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Spacing="12" IsHitTestVisible="False">
            <SymbolIcon Symbol="Download" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Build your starting grid" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="Drop mod packages here or choose Add mods.&#xA;Your collection will appear in this library." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Grid.Row="3" Text="Drop packages into the library to add them. Right-click a mod for more actions." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>

    <Border Grid.Row="2" Padding="28,18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="Ready when you are" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="Enable your mods, then apply changes to the game." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <SplitButton Grid.Column="1" Content="Apply changes" VerticalAlignment="Center" Click="ApplyButton_Click" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" AutomationProperties.AutomationId="ApplyChangesButton">
          <SplitButton.Flyout>
            <MenuFlyout Placement="Top">
              <MenuFlyoutItem Text="Uninstall all mods" Click="UninstallAllItem_Click"/>
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
      </Grid>
    </Border>
  </Grid>
</Window>
